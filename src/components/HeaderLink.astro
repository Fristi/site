---
import type { HTMLAttributes } from "astro/types";
import { useUserAgent } from "astro-useragent";

type Props = HTMLAttributes<"a">;

const uaString = Astro.request.headers.get("user-agent");
const { isMobile } = useUserAgent(uaString);
const { href, ...props } = Astro.props;
const link = href?.toString();
const { pathname } = Astro.url;

const isActive = link === pathname || link === pathname.replace(/\/$/, "");
const baseStyles = !isMobile
  ? "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
  : "block pl-3 pr-4 py-2 border-l-4 text-base font-medium";

var activeStyles = "";

if (!isMobile) {
  activeStyles = isActive
    ? "border-indigo-600 text-indigo-600"
    : "border-transparent text-gray-600 hover:border-gray-400 hover:text-gray-900";
} else {
  activeStyles = isActive
    ? "bg-indigo-600/10 border-indigo-600 text-indigo-600"
    : "border-transparent text-gray-600 hover:bg-gray-100 hover:border-gray-400 hover:text-gray-900";
}

const styles = baseStyles + " " + activeStyles;
---

<a href={href} class={styles} {...props}>
  <slot />
</a>
