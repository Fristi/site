---
import Shell from "./Shell.astro";
import BaseHead from "./BaseHead.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Mark de Jong",
  description = "Software development",
  image = "/img/logo.png",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead
    description={description}
    title={title}
    image={image}
  />
  <Shell>
    <slot />
  </Shell>
</html>
