---
import HeaderLink from "../components/HeaderLink.astro";
import Footer from "../components/Footer.astro";
---

<>
  <body class="bg-gray-100 font-sans text-gray-900 antialiased">
    <div class="mx-auto min-h-screen max-w-7xl p-4 md:p-6">
      <div class="rounded-2xl bg-white shadow-sm">
        <nav class="flex items-center border-b border-gray-200 px-4 md:px-6 h-16">
          <div class="flex-1">
            <a
              href="/"
              class="inline-flex items-center px-3 py-2 rounded-lg font-condensed text-lg font-black uppercase tracking-normal hover:bg-gray-100 transition-colors"
            >
              Mark de Jong
            </a>
          </div>

          <button
            id="nav-button"
            type="button"
            class="inline-flex items-center px-3 py-1 text-sm bg-indigo-600 text-white rounded-lg md:hidden hover:bg-indigo-700 transition-colors"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            Menu
          </button>

          <div class="hidden items-center gap-2 md:flex">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/project">Projects</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
          </div>
        </nav>

        <div id="nav-bar" class="hidden border-b border-gray-200 px-4 py-3 md:hidden">
          <div class="flex flex-col gap-2">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/project">Projects</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
          </div>
        </div>

        <main class="px-4 py-6 md:px-6 md:py-8">
          <slot />
        </main>

        <div class="border-t border-gray-200 px-4 py-4 md:px-6">
          <Footer />
        </div>
      </div>
    </div>
  </body>

  <script>
    const navButton = document.getElementById("nav-button");
    const navBar = document.getElementById("nav-bar");

    navButton?.addEventListener("click", () => {
      navBar?.classList.toggle("hidden");
    });
  </script>
</>
