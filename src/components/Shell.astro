---
import HeaderLink from "../components/HeaderLink.astro";
import Footer from "../components/Footer.astro";
---

<>
  <body class="bg-void font-body text-on-surface antialiased">
    <div class="relative mx-auto min-h-screen max-w-7xl">
      <!-- Atmospheric background blobs -->
      <div aria-hidden class="pointer-events-none fixed inset-0 overflow-hidden -z-10">
        <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-primary opacity-[0.04] blur-[100px]" />
        <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-secondary opacity-[0.04] blur-[100px]" />
      </div>

      <nav class="sticky top-0 z-50 flex items-center border-b border-outline-variant/20 bg-void/80 backdrop-blur-[12px] px-4 md:px-8 h-16">
        <div class="flex-1">
          <a
            href="/"
            class="inline-flex items-center px-3 py-1.5 rounded-xl font-display font-black uppercase tracking-wide text-sm text-on-surface hover:text-primary transition-colors"
          >
            Mark de Jong
          </a>
        </div>

        <button
          id="nav-button"
          type="button"
          class="inline-flex items-center px-3 py-1 text-sm bg-primary text-on-primary font-medium rounded-xl md:hidden hover:brightness-110 transition-all"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          Menu
        </button>

        <div class="hidden items-center gap-1 md:flex">
          <HeaderLink href="/">Home</HeaderLink>
          <HeaderLink href="/project">Projects</HeaderLink>
          <HeaderLink href="/blog">Blog</HeaderLink>
        </div>
      </nav>

      <div id="nav-bar" class="hidden border-b border-outline-variant/20 bg-void/90 px-4 py-3 md:hidden">
        <div class="flex flex-col gap-1">
          <HeaderLink href="/">Home</HeaderLink>
          <HeaderLink href="/project">Projects</HeaderLink>
          <HeaderLink href="/blog">Blog</HeaderLink>
        </div>
      </div>

      <main class="px-4 py-10 md:px-8 md:py-16">
        <slot />
      </main>

      <Footer />
    </div>
  </body>

  <script>
    const navButton = document.getElementById("nav-button");
    const navBar = document.getElementById("nav-bar");

    navButton?.addEventListener("click", () => {
      navBar?.classList.toggle("hidden");
    });
  </script>
</>
