---
import HeaderLink from "../components/HeaderLink.astro";
import Footer from "../components/Footer.astro";
---

<>
  <body
    data-theme="caramellatte"
    class="bg-base-200 font-sans text-base-content antialiased"
  >
    <div class="mx-auto min-h-screen max-w-7xl p-4 md:p-6">
      <div class="card bg-base-100 shadow-sm">
        <nav class="navbar border-b border-base-300 px-4 md:px-6">
          <div class="flex-1">
            <a
              href="/"
              class="btn btn-ghost font-condensed text-lg font-black uppercase tracking-normal"
            >
              Mark de Jong
            </a>
          </div>

          <button
            id="nav-button"
            type="button"
            class="btn btn-primary btn-sm md:hidden"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            Menu
          </button>

          <div class="hidden items-center gap-2 md:flex">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/project">Projects</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
          </div>
        </nav>

        <div id="nav-bar" class="hidden border-b border-base-300 px-4 py-3 md:hidden">
          <div class="flex flex-col gap-2">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/project">Projects</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
          </div>
        </div>

        <main class="px-4 py-6 md:px-6 md:py-8">
          <slot />
        </main>

        <div class="border-t border-base-300 px-4 py-4 md:px-6">
          <Footer />
        </div>
      </div>
    </div>
  </body>

  <script>
    const navButton = document.getElementById("nav-button");
    const navBar = document.getElementById("nav-bar");

    navButton?.addEventListener("click", () => {
      navBar?.classList.toggle("hidden");
    });
  </script>
</>
