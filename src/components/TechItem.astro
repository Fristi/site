---
import StackIcon from "tech-stack-icons";
type Props = {
  tech: string;
  showLabel?: boolean;
  iconClass?: string;
};

const { tech, showLabel = true, iconClass = "w-12 h-12" } = Astro.props;
const not_supported = ["akka", "typelevel", "kafka", "zio", "keycloak"];
---

<span class={showLabel ? "p-3 flex flex-col items-center" : ""}>
  {
    not_supported.includes(tech) ? (
      <img
        src={`/img/tech/${tech}.svg`}
        alt={tech}
        class={`${iconClass} rounded filter grayscale`}
      />
    ) : (
      <StackIcon
        variant="grayscale"
        className={`${iconClass} rounded`}
        name={tech}
      />
    )
  }
  {showLabel && (
    <span class="mt-1 text-xs font-bold uppercase tracking-tight text-on-surface-variant">
      {tech}
    </span>
  )}
</span>
