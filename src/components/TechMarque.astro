---
import TechItems from "./TechItems.astro";

type Props = {
  tech: string[];
};

const { tech } = Astro.props;
---

{
  tech && (
    <div class="mt-20" data-animate="fade-up">
      <p class="text-xs font-mono uppercase tracking-[0.2em] text-primary">
        Stack
      </p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-[-0.01em] text-on-surface md:text-3xl">
        Tech & tools
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center">
        <TechItems tech={tech} />
      </div>
    </div>
  )
}
