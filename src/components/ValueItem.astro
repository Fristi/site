---
type Props = {
  text: string;
  result: number;
};

const { text, result } = Astro.props;
---

<div class="rounded-2xl border border-outline-variant/20 bg-surface-high/40 px-5 py-6 backdrop-blur-[16px]">
  <dt class="text-sm text-on-surface-variant">{text}</dt>
  <dd
    class="mt-2 font-display text-3xl font-semibold tracking-tight text-on-surface"
    data-count={result}
  >
    {result.toLocaleString("en-US")}
  </dd>
</div>
