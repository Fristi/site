---
import type { CollectionEntry } from "astro:content";

import FormattedDate from "../components/FormattedDate.astro";
import Shell from "../components/Shell.astro";
import BaseHead from "../components/BaseHead.astro";
import BlogSeries from "../components/BlogSeries.astro";

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
};

const { title, description, pubDate, banner, series, slug } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead description={description} title={title} image={banner} />
  <Shell>
    <div class="relative overflow-hidden">
      <div class="mt-8 mb-8 relative px-4 sm:px-6 lg:px-8">
        <div class="text-lg max-w-4xl mx-auto">
          <h1>
            <span
              class="block text-base text-center text-indigo-600 font-semibold tracking-wide uppercase"
              ><FormattedDate date={pubDate} />
              <span
                class="mt-2 block text-2xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-3xl"
                >{title}</span
              >
            </span>
            <p class="mt-2 text-md text-center text-gray-500 leading-8">
              {description}
            </p>
          </h1>
          <div
            class="mt-6 prose prose-stone prose-indigo prose-lg text-gray-500 mx-auto max-w-none"
          >
            <slot />
          </div>
          {series && <BlogSeries currentSlug={slug} series={series} />}
        </div>
      </div>
    </div>
  </Shell>
</html>
