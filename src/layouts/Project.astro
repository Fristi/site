---
import type { CollectionEntry } from "astro:content";

import Layout from "../components/Layout.astro";
import BrochureBlock from "../components/BrochureBlock.astro";
import ValueItem from "../components/ValueItem.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TechMarque from "../components/TechMarque.astro";

type Props = CollectionEntry<"project">["data"];

const { title, description, pubDate, banner, value, brochure, tech } =
  Astro.props;
---

<Layout title={title} description={description} image={banner}>
  <article>
    <header class="relative overflow-hidden rounded-2xl border border-outline-variant/20">
      <div class="absolute inset-0">
        <img
          data-animate="scale-img"
          class="h-full w-full object-cover will-change-transform"
          src={banner}
          alt=""
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/15"
          aria-hidden
        />
      </div>
      <div class="relative flex min-h-[22rem] flex-col justify-end px-6 py-10 md:min-h-[28rem] md:px-12 md:py-14">
        <p class="text-xs font-mono uppercase tracking-[0.2em] text-white/70">
          <FormattedDate date={pubDate} />
        </p>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold leading-[1.1] tracking-[-0.02em] text-white md:text-5xl">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
          {description}
        </p>
      </div>
    </header>

    <div
      class="prose prose-stone prose-indigo mx-auto mt-12 max-w-3xl text-on-surface-variant"
      data-animate="fade-up"
    >
      <slot />
    </div>

    {
      brochure.map((item, idx) => (
        <BrochureBlock {...item} flip={idx % 2 === 1} />
      ))
    }

    {
      value && (
        <section class="mt-20" data-animate="fade-up">
          <p class="text-xs font-mono uppercase tracking-[0.2em] text-primary">
            Impact
          </p>
          <h2 class="mt-3 font-display text-2xl font-bold tracking-[-0.01em] text-on-surface md:text-3xl">
            Value
          </h2>
          <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
            {value.map((v) => (
              <ValueItem {...v} />
            ))}
          </dl>
        </section>
      )
    }

    <TechMarque tech={tech} />

    <p class="mt-16" data-animate="fade-up">
      <a
        href="/project"
        class="text-sm font-medium text-on-surface-variant transition-colors hover:text-primary"
      >
        ← All projects
      </a>
    </p>
  </article>
</Layout>
