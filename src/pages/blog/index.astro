---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../components/Layout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .reverse();
---

<Layout>
  <div>
    <div class="flex items-end justify-between" data-animate="fade-up">
      <div>
        <h1 class="font-display text-[2.75rem] font-extrabold leading-[1.1] tracking-[-0.02em] text-on-surface">
          From the blog
        </h1>
        <p class="mt-3 text-base text-on-surface-variant">
          Latest rumblings around tech
        </p>
      </div>
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="mb-1 inline-flex items-center gap-2 text-sm font-medium text-on-surface-variant hover:text-primary transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        RSS
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-outline-variant/20 transition-all duration-300 hover:border-outline-variant/30 hover:shadow-[0_0_40px_2px_rgba(153,247,255,0.08)]">
          <!-- Banner image with gradient overlay -->
          <a href={`/blog/${post.slug}`} class="relative block h-48 overflow-hidden flex-shrink-0">
            <img
              src={post.data.banner}
              alt=""
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
          </a>

          <!-- Card content -->
          <div class="relative flex flex-col flex-1 bg-surface-high/40 backdrop-blur-[16px] p-5">
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary to-primary-container opacity-[0.02]" aria-hidden />
            <div class="relative flex items-center gap-3 text-xs text-on-surface-variant/70 mb-3">
              <img
                src="/img/mark_avatar.jpg"
                alt=""
                class="h-5 w-5 flex-none rounded-full ring-1 ring-outline-variant/30"
              />
              <span>Mark</span>
              <span aria-hidden>·</span>
              <time><FormattedDate date={post.data.pubDate} /></time>
            </div>
            <h2 class="relative font-display font-semibold text-base text-on-surface group-hover:text-primary transition-colors flex-1">
              <a href={`/blog/${post.slug}`}>
                <span class="absolute inset-0" />
                {post.data.title}
              </a>
            </h2>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
