---
import Client from "../components/Client.astro";
import Layout from "../components/Layout.astro";

const talks = [
  {
    date: "2023",
    name: "ZIO test vs Scalatest",
    description: "At vandebron I gave a talk to compare zio-test vs scalatest",
    url: "https://fristi.github.io/zio-test-presentation/",
  },
  {
    date: "2023",
    name: "refined",
    description: "During amsterdam.scala meetup at vandebron I gave a introduction talk to refinement types in Scala",
    url: "https://fristi.github.io/refined-deck",
  },
  {
    date: "2023",
    name: "Rust introduction",
    description: "Gave a Rust introduction talk at Flock.community",
    url: "https://fristi.github.io/rust-introduction",
  },
  {
    date: "2022",
    name: "Bazel",
    description: "At amsterdam.scala I gave an introduction talk about Bazel and Scala",
    url: "https://fristi.github.io/bazel-deck",
  },
  {
    date: "2020",
    name: "cats",
    description: "At DHL I gave a talk about the functional programming library cats in Scala",
    url: "https://fristi.github.io/cats-deck",
  },
  {
    date: "2018",
    name: "http4s",
    description: "At functional rotterdam meetup I gave a talk about http4s, a functional http server/client library written in Scala",
    url: "https://fristi.github.io/http4s-deck",
  },
];

const openSourceProjects = [
  {
    date: "2018",
    name: "septic",
    description:
      "Small utility library to perform model based property based testing on tagless final algebras in Scala",
    url: "https://github.com/Fristi/septic",
  },
  {
    date: "2018",
    name: "goedverhaal",
    description:
      "Small proof of concept of a Monad which includes lazy compensating actions. This means, when a computation fails it will attempt to roll it back",
    url: "https://github.com/Fristi/goedverhaal",
  },
  {
    date: "2018",
    name: "itinere",
    description:
      "A eDSL (embedded domain specific language) in Scala to describe HTTP endpoints. From these declarations you can implement a server/client or generate OpenAPI docs",
    url: "https://github.com/Fristi/itinere",
  },
  {
    date: "2017",
    name: "flumina",
    description:
      "A native Kafka driver written from the ground up, so encoding/decoding messages from and to the Kafka broker, multiplexing, etc",
    url: "https://github.com/Fristi/flumina",
  },
  {
    date: "2017",
    name: "formulation",
    description:
      "A eDSL (embedded domain specific language) in Scala to map data structures to Avro encoders, decoders and schemas",
    url: "https://github.com/Fristi/formulation",
  }
];

const certs = [
  {
    image: "/img/cert/nielsen-norman.png",
    title: "Nielsen Norman / Interaction design",
    description:
      "Nielsen Norman Group, an elite firm dedicated to improving the everyday experience of using technology. I took courses on interaction design with the focus on apps.",
  },
  {
    image: "/img/cert/coursera.png",
    title: "Machine Learning by Andrew Ng",
    description:
      "Machine learning is the science of getting computers to act without being explicitly programmed. In the past decade, machine learning has given us self-driving cars, speech recognition, web search, etc.",
  },
  {
    image: "/img/cert/ckad.png",
    title: "CKAD - Certified Kubernetes Application Developer",
    description:
      "Be able to define application resources and use core primitives to build, monitor, and troubleshoot scalable applications and tools in Kubernetes.",
  },
];
---

<Layout>

  <!-- Hero -->
  <section class="relative overflow-hidden -mx-4 md:-mx-8 px-4 md:px-8 py-20 md:py-32">
    <!-- Background blobs (mirrors BlobBackground component) -->
    <div aria-hidden class="pointer-events-none absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-primary opacity-[0.05] blur-[80px]" />
    <div aria-hidden class="pointer-events-none absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-secondary opacity-[0.05] blur-[80px]" />

    <!-- Sketch portrait — blends into background via multiply -->
    <div aria-hidden class="pointer-events-none absolute right-0 top-0 bottom-0 w-[45%] hidden lg:block">
      <!-- Fade mask: right side fades in, left edge fades out -->
      <div class="absolute inset-0 z-10"
        style="mask-image: linear-gradient(to right, transparent 0%, black 25%, black 75%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 25%, black 75%, transparent 100%);">
        <img
          src="/img/mark_sketch.jpg"
          alt=""
          class="h-full w-full object-cover object-top"
          style="mix-blend-mode: multiply; opacity: 0.55;"
        />
      </div>
    </div>

    <div class="relative max-w-2xl">
      <!-- Display heading -->
      <h1 class="font-display font-extrabold text-[3.5rem] leading-[1.1] tracking-[-0.02em] text-on-surface">
        Crafting systems<br />that scale
      </h1>

      <!-- Body text -->
      <p class="mt-6 font-body text-base leading-relaxed text-on-surface-variant max-w-xl">
        I help engineering teams design and build high-throughput backends, data
        pipelines, and functional systems — with Scala, Rust, and Kafka at the core.
        13+ years of experience across energy, finance, logistics, and telecom.
      </p>

      <!-- CTAs (primary button + glass button as anchor tags) -->
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/project"
          class="inline-flex items-center justify-center gap-2 rounded-xl font-body font-medium px-5 py-2.5 text-sm transition-all duration-200 bg-primary text-on-primary shadow-[0_0_20px_2px_rgba(153,247,255,0.25)] hover:shadow-[0_0_32px_4px_rgba(153,247,255,0.35)] hover:brightness-105"
        >
          View work
        </a>
        <a
          href="https://www.linkedin.com/in/mark-de-jong-a808b7167"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl font-body font-medium px-5 py-2.5 text-sm transition-all duration-200 bg-surface-high/50 backdrop-blur-[16px] text-on-surface border border-outline-variant/20 hover:bg-surface-highest/60 hover:backdrop-blur-[20px]"
        >
          Get in touch
        </a>
      </div>

      <!-- Social links -->
      <div class="mt-10 flex gap-4">
        <a
          target="_blank"
          href="https://github.com/Fristi"
          class="text-on-surface-variant hover:text-primary transition-colors"
          aria-label="GitHub"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          target="_blank"
          href="https://www.linkedin.com/in/mark-de-jong-a808b7167"
          class="text-on-surface-variant hover:text-primary transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="mt-8 lg:grid lg:grid-cols-2 lg:gap-16 items-start">
    <div>
      <h2 class="font-display text-[2rem] font-bold tracking-[-0.01em] text-on-surface">
        About
      </h2>

      <div class="mt-6 space-y-4 text-base leading-7 text-on-surface-variant">
        <p>
          <strong class="font-semibold text-on-surface">Mark de Jong</strong> is an experienced software engineer who writes robust and scalable software, designs user-friendly
          interfaces, mentors others, and reviews code with care.
        </p>
        <p>
          With over 13 years of professional experience, I've delivered
          projects across diverse industries including renewable energy,
          logistics, finance, healthcare, telecom, and education. From
          building high-performance backends and large-scale billing
          systems, to crafting custom CMS platforms and mobile apps, my work
          combines functional programming principles with real-world impact.
        </p>
        <p>
          I've contributed to open-source Scala projects like Cats, Tapir, and
          Doobie, and introduced novel ideas such as the Saga Monad (now
          adopted in Arrow and ZIO). I'm driven by curiosity, and I enjoy
          solving hard problems—whether it's optimizing protocols, designing
          internal DSLs, or writing firmware in Rust for embedded devices.
        </p>
        <ul class="space-y-1 list-disc list-inside text-on-surface-variant">
          <li>Custom content management systems</li>
          <li>High performance backends &amp; financial systems</li>
          <li>Single page web apps and mobile apps</li>
          <li>Marketing pages &amp; community platforms</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 lg:mt-0">
      <img
        class="w-full rounded-2xl object-cover ring-1 ring-outline-variant/20"
        src="/img/collage.jpg"
        alt="Mark"
      />
    </div>
  </section>

  <!-- Tech Volunteer -->
  <section class="mt-24">
    <div class="mb-10">
      <h2 class="font-display text-[2rem] font-bold tracking-[-0.01em] text-on-surface">
        Tech volunteer
      </h2>
      <p class="mt-2 text-base text-on-surface-variant">
        During the years I gave talks for free, contributed to OSS projects and also had my own OSS projects
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Talks -->
      <div class="relative rounded-2xl border border-outline-variant/20 bg-surface-high/40 backdrop-blur-[16px] p-6">
        <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-primary to-primary-container opacity-[0.03]" aria-hidden />
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary flex-shrink-0">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-on-surface">Talks Given</h3>
        </div>
        <p class="mt-3 text-sm text-on-surface-variant">Mostly talks at meetups and companies</p>
        <ul class="mt-6 space-y-6">
          {talks.map((talk) => (
            <li>
              <p class="text-xs font-mono text-on-surface-variant/60">{talk.date}</p>
              <a
                href={talk.url}
                target="_blank"
                rel="noreferrer"
                class="mt-1 block text-base font-semibold text-primary hover:text-primary-container transition-colors"
              >
                {talk.name}
              </a>
              <p class="mt-1 text-sm text-on-surface-variant leading-relaxed">{talk.description}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- OSS -->
      <div class="relative rounded-2xl border border-outline-variant/20 bg-surface-high/40 backdrop-blur-[16px] p-6">
        <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-secondary to-primary opacity-[0.03]" aria-hidden />
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-secondary/10 text-secondary flex-shrink-0">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-on-surface">Open Source Projects</h3>
        </div>
        <p class="mt-3 text-sm text-on-surface-variant">Public work and contributions available online.</p>
        <ul class="mt-6 space-y-6">
          {openSourceProjects.map((project) => (
            <li>
              <p class="text-xs font-mono text-on-surface-variant/60">{project.date}</p>
              <a
                href={project.url}
                target="_blank"
                rel="noreferrer"
                class="mt-1 block text-base font-semibold text-primary hover:text-primary-container transition-colors"
              >
                {project.name}
              </a>
              <p class="mt-1 text-sm text-on-surface-variant leading-relaxed">{project.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Worked for -->
  <section class="mt-24">
    <div class="mb-10">
      <h2 class="font-display text-[2rem] font-bold tracking-[-0.01em] text-on-surface">
        Worked for
      </h2>
      <p class="mt-2 text-base text-on-surface-variant">
        I served these employers to be successful in the digital world
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <Client
        image="/img/companies/vandebron.png"
        name="Vandebron"
        description="Vandebron is a Dutch green energy marketplace that connects households and businesses directly with local renewable producers—like farmers with wind turbines, solar panels, or biogas—without owning any generation assets."
      />
      <Client
        image="/img/companies/dhl.png"
        name="DHL"
        description="DHL German international courier, package delivery and express mail service. I've worked at DHL on several high-end web applications."
      />
      <Client
        image="/img/companies/ing.png"
        name="ING"
        description="The ING Group is a Dutch multinational banking and financial services corporation. I've worked at ING on approval software."
      />
      <Client
        image="/img/companies/veon.png"
        name="Veon"
        description="VEON is a Dutch-domiciled multinational telecommunication services. It predominantly operates services in the regions of Asia, Africa and Europe. I've worked at VEON on the top up transactional systems."
      />
      <Client
        image="/img/companies/malmberg.svg"
        name="Malmberg"
        description="Malmberg is a Dutch company which creates educational software and books for schools. I've worked on Malmberg on a content management system (CMS) for educational software."
      />
    </div>
  </section>

  <!-- Certified -->
  <section class="mt-24">
    <div class="mb-10">
      <h2 class="font-display text-[2rem] font-bold tracking-[-0.01em] text-on-surface">
        Certified
      </h2>
      <p class="mt-2 text-base text-on-surface-variant">
        Driven to keep up with latest trends and technologies
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {certs.map((cert) => (
        <div class="relative flex gap-5 rounded-2xl border border-outline-variant/20 bg-surface-high/40 backdrop-blur-[16px] p-6 transition-all duration-300 hover:border-outline-variant/30 hover:shadow-[0_0_30px_2px_rgba(153,247,255,0.06)]">
          <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-primary to-primary-container opacity-[0.03]" aria-hidden />
          <div class="relative flex-shrink-0">
            <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-surface-highest">
              <img src={cert.image} alt={cert.title} class="h-10 w-10 object-contain" />
            </div>
          </div>
          <div class="relative">
            <h3 class="font-display font-semibold text-sm text-on-surface leading-snug">{cert.title}</h3>
            <p class="mt-2 text-sm text-on-surface-variant leading-relaxed">{cert.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
