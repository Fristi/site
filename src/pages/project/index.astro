---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";

const posts = (await getCollection("project"))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .reverse();
---

<Layout>
  <div>
    <h1 class="font-display text-[2.75rem] font-extrabold leading-[1.1] tracking-[-0.02em] text-on-surface">
      Projects
    </h1>
    <p class="mt-3 text-base text-on-surface-variant">
      Some projects I have been working on the past few years
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/project/${post.slug}`}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-high/40 backdrop-blur-[16px] transition-all duration-300 hover:border-outline-variant/30 hover:shadow-[0_0_40px_2px_rgba(153,247,255,0.08)]"
        >
          <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-primary to-primary-container opacity-[0.03]" aria-hidden />
          <div class="relative h-40 overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={post.data.banner}
              alt={post.data.title}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-high/80 to-transparent" />
          </div>
          <div class="relative flex flex-col flex-1 p-5">
            <h2 class="font-display font-semibold text-base text-on-surface group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm text-on-surface-variant leading-relaxed flex-1">
              {post.data.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
